-- ============================================================
-- SECTION 1: SCHEMA & STAGING TABLES
-- ============================================================

CREATE SCHEMA IF NOT EXISTS novatech;

-- ── TABLE 1: P&L Summary ────────────────────────────────────
CREATE TABLE novatech.pnl_summary (
    fiscal_year             INT,
    quarter                 VARCHAR(2),
    period                  VARCHAR(10),
    total_revenue_usd       NUMERIC(15,2),
    total_cogs_usd          NUMERIC(15,2),
    gross_profit_usd        NUMERIC(15,2),
    gross_margin_pct        NUMERIC(6,2),
    total_opex_usd          NUMERIC(15,2),
    ebit_usd                NUMERIC(15,2),
    ebit_margin_pct         NUMERIC(6,2),
    interest_expense_usd    NUMERIC(15,2),
    ebt_usd                 NUMERIC(15,2),
    net_income_usd          NUMERIC(15,2),
    net_margin_pct          NUMERIC(6,2)
);

-- ── TABLE 2: Budget vs Actuals ───────────────────────────────
CREATE TABLE novatech.budget_vs_actuals (
    fiscal_year             INT,
    quarter                 VARCHAR(2),
    period                  VARCHAR(10),
    department              VARCHAR(60),
    cost_type               VARCHAR(20),
    headcount               INT,
    budget_usd              NUMERIC(15,2),
    actual_usd              NUMERIC(15,2),
    variance_usd            NUMERIC(15,2),
    variance_pct            NUMERIC(6,2),
    has_actual              BOOLEAN
);

-- ── TABLE 3: Revenue by Product & Region ────────────────────
CREATE TABLE novatech.revenue_by_product_region (
    fiscal_year             INT,
    quarter                 VARCHAR(2),
    period                  VARCHAR(10),
    region                  VARCHAR(30),
    product_name            VARCHAR(60),
    product_category        VARCHAR(40),
    deals_closed            INT,
    avg_deal_value_usd      NUMERIC(15,2),
    revenue_usd             NUMERIC(15,2),
    cogs_usd                NUMERIC(15,2),
    gross_profit_usd        NUMERIC(15,2),
    gross_margin_pct        NUMERIC(6,2)
);

-- ── TABLE 4: KPI Targets vs Actuals ─────────────────────────
CREATE TABLE novatech.kpi_targets_actuals (
    fiscal_year             INT,
    kpi_name                VARCHAR(60),
    target                  NUMERIC(8,2),
    actual                  NUMERIC(8,2),
    vs_target               NUMERIC(8,2),
    status                  VARCHAR(15)
);


