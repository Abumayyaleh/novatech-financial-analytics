-- ============================================================
-- SECTION 3: DATA VALIDATION & SANITY CHECKS
-- ============================================================

-- ── CHECK 1: Period coverage — confirm all expected quarters exist
SELECT
    fiscal_year,
    COUNT(DISTINCT quarter)                         AS quarters_present,
    STRING_AGG(quarter, ', ' ORDER BY quarter)      AS quarters
FROM novatech.pnl_summary
GROUP BY fiscal_year
ORDER BY fiscal_year;
-- Expected: 2022-2024 have 4 quarters each, 2025 has 1

-- ── CHECK 2: Null check on critical financial columns
SELECT
    SUM(CASE WHEN total_revenue_usd  IS NULL THEN 1 ELSE 0 END) AS null_revenue,
    SUM(CASE WHEN gross_profit_usd   IS NULL THEN 1 ELSE 0 END) AS null_gross_profit,
    SUM(CASE WHEN ebit_usd           IS NULL THEN 1 ELSE 0 END) AS null_ebit,
    SUM(CASE WHEN net_income_usd     IS NULL THEN 1 ELSE 0 END) AS null_net_income
FROM novatech.pnl_summary;
-- Expected: all zeros

-- ── CHECK 3: Budget actuals — confirm 2025 has nulls only in future quarters
SELECT
    fiscal_year,
    quarter,
    COUNT(*)                                                AS total_rows,
    SUM(CASE WHEN actual_usd IS NULL THEN 1 ELSE 0 END)   AS null_actuals
FROM novatech.budget_vs_actuals
GROUP BY fiscal_year, quarter
ORDER BY fiscal_year, quarter;
-- Expected: only 2025 Q2/Q3/Q4 have null actuals

-- ── CHECK 4: Gross profit reconciliation
SELECT
    period,
    gross_profit_usd                                AS reported_gross_profit,
    ROUND(total_revenue_usd - total_cogs_usd, 2)   AS calculated_gross_profit,
    ROUND(gross_profit_usd -
         (total_revenue_usd - total_cogs_usd), 2)  AS discrepancy
FROM novatech.pnl_summary
WHERE ROUND(gross_profit_usd -
           (total_revenue_usd - total_cogs_usd), 2) <> 0;
-- Expected: 0 rows returned

-- ── CHECK 5: KPI status distribution
SELECT
    status,
    COUNT(*) AS count
FROM novatech.kpi_targets_actuals
GROUP BY status;
-- Expected: only Hit / Miss / Forecast
